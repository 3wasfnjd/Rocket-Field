						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">playRandomSoundFromSource</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">32b606fd8310daf50ae6f6960000601b</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX4B60E43870B040ABA3B5A6C28CB565D0">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local function playSoundFromSource(playerTemplate: AudioPlayer, target: Instance)
	local audioPlayer = playerTemplate:Clone()
	audioPlayer.Parent = target

	local wire = Instance.new("Wire")
	wire.SourceInstance = audioPlayer
	wire.TargetInstance = target
	wire.Parent = audioPlayer

	audioPlayer:Play()
	audioPlayer.Ended:Once(function()
		audioPlayer:Destroy()
	end)
end

return playSoundFromSource
]]></ProtectedString>
